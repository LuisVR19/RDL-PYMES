---
import '../styles/global.css'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import WhatsAppFloat from '../components/WhatsAppFloat.astro'
import { config } from '../lib/config'
import { content } from '../lib/content'

/**
 * Esqueleto de todas las páginas (Paso 5): `lang="es-CR"`, título y descripción únicos, canónica, Open Graph,
 * Twitter Card, JSON-LD de la organización y, si está configurada, la analítica sin cookies.
 */
interface Props {
  title: string
  description: string
  /** Borradores legales y 404: fuera de buscadores. */
  noindex?: boolean
  /** Datos estructurados propios de la página (SoftwareApplication, FAQPage…). */
  jsonLd?: object[]
}

const { title, description, noindex = false, jsonLd = [] } = Astro.props
const canonical = new URL(Astro.url.pathname, config.siteUrl).toString()
const ogImage = new URL('/og.png', config.siteUrl).toString()
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: content.brand,
  url: config.siteUrl,
  logo: new URL('/favicon.svg', config.siteUrl).toString(),
  ...(config.contact.email
    ? {
        contactPoint: {
          '@type': 'ContactPoint',
          contactType: 'sales',
          email: config.contact.email,
          areaServed: 'CR',
          availableLanguage: 'es',
        },
      }
    : {}),
}
const structured = [organization, ...jsonLd]
---

<!doctype html>
<html lang="es-CR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- Antes que el CSS: pone el tema sin parpadeo. Archivo externo, compatible con la CSP. -->
    <script is:inline src="/theme.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0F1B33" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:site_name" content={content.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {structured.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    {config.umami && <script defer src={config.umami.src} data-website-id={config.umami.websiteId} />}
  </head>
  <body>
    <a class="skip" href="#contenido">
      {content.nav.skip}
    </a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <script>
      import { initUtm } from '../lib/utm-client'
      initUtm()
    </script>
  </body>
</html>
