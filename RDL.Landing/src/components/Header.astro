---
import { content } from '../lib/content'
import Icon from './Icon.astro'
import Logo from './Logo.astro'
import PortalLinks from './PortalLinks.astro'
import ThemeToggle from './ThemeToggle.astro'

/** Encabezado fijo (Paso 1 §1): marca, anclas de la principal, «Iniciar sesión» y «Crear cuenta» siempre a mano. */
const t = content.nav
---

<header class="header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${content.brand}, inicio`}>
      <Logo size={32} />
      <span class="brandName">{content.brand}</span>
    </a>

    <nav class="nav" id="menu-principal" aria-label={t.mainLabel} data-open="false">
      <ul class="links">
        {t.links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
      <div class="menuActions">
        <PortalLinks show="signup" />
      </div>
    </nav>

    <div class="actions">
      <ThemeToggle />
      <PortalLinks show="login" variant="secondary" class="login" />
      <span class="desktopOnly">
        <PortalLinks show="signup" />
      </span>
      <button
        class="btn btn-secondary menuButton"
        type="button"
        aria-controls="menu-principal"
        aria-expanded="false"
        data-open-label={t.openMenu}
        data-close-label={t.closeMenu}
        aria-label={t.openMenu}
      >
        <span class="iconOpen">
          <Icon name="menu" size={20} />
        </span>
        <span class="iconClose">
          <Icon name="x" size={20} />
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  // Menú móvil: abre y cierra el panel de navegación; Esc o elegir un enlace lo cierran.
  const button = document.querySelector<HTMLButtonElement>('.menuButton')
  const nav = document.getElementById('menu-principal')
  if (button && nav) {
    const set = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open))
      button.setAttribute('aria-label', (open ? button.dataset.closeLabel : button.dataset.openLabel) ?? '')
      nav.dataset.open = String(open)
    }
    button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'))
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false)
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        set(false)
        button.focus()
      }
    })
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: var(--color-bg-surface);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .brandName {
    font: 600 18px/24px var(--font-sans);
  }

  .nav {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .links {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 10px;
    border-radius: var(--radius-md);
    color: var(--color-text-strong, var(--color-text-primary));
    font: 500 14px/20px var(--font-sans);
    text-decoration: none;
  }

  .links a:hover {
    background: var(--color-bg-subtle);
  }

  .menuActions {
    display: none;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }

  .menuButton {
    display: none;
    width: 44px;
    padding: 0;
  }

  .iconClose {
    display: none;
  }

  .menuButton[aria-expanded='true'] .iconOpen {
    display: none;
  }

  .menuButton[aria-expanded='true'] .iconClose {
    display: inline;
  }

  /* Tableta y móvil: las anclas pasan a un panel debajo del encabezado. */
  @media (max-width: 1023px) {
    .menuButton {
      display: inline-flex;
    }

    .desktopOnly {
      display: none;
    }

    .nav {
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      padding: var(--space-3) var(--page-pad) var(--space-5);
      background: var(--color-bg-surface);
      border-bottom: 1px solid var(--color-border-default);
      box-shadow: var(--shadow-md);
    }

    .nav[data-open='true'] {
      display: flex;
    }

    .links {
      flex-direction: column;
    }

    .links a {
      height: 44px;
      width: 100%;
      font-size: 16px;
    }

    .menuActions {
      display: flex;
    }
  }

  @media (max-width: 479px) {
    .brandName {
      display: none;
    }
  }
</style>
