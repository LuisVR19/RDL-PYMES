# Copiar a .env (ignorado por git). Se leen al construir: cada ambiente construye con sus valores.
# TODOS los valores de abajo son TEMPORALES DE PRUEBA: reemplazarlos antes de publicar.

# Sitio publicado (canónicas, sitemap, Open Graph).
PUBLIC_SITE_URL=https://www.rdl.example

# Portal web. «Iniciar sesión» lleva a PORTAL_URL + LOGIN_PATH.
PUBLIC_PORTAL_URL=http://localhost:5173
PUBLIC_PORTAL_LOGIN_PATH=/ingresar
# El portal ya tiene /registro (2026-09-28). Póngalo en true cuando el portal de ese ambiente esté publicado y el
# registro esté habilitado en su Supabase; con false, «Crear cuenta» se ve como «Próximamente».
PUBLIC_SIGNUP_ENABLED=false
PUBLIC_PORTAL_SIGNUP_PATH=/registro

# Contacto (pie, preguntas frecuentes, botón de WhatsApp).
PUBLIC_CONTACT_EMAIL=ventas@rdl.example
# Solo dígitos, con el 506. 50600000000 no es un número real: ningún mensaje de prueba le llega a nadie.
PUBLIC_CONTACT_WHATSAPP=50600000000
PUBLIC_CONTACT_PHONE_DISPLAY=+506 0000 0000
PUBLIC_CONTACT_HOURS=lunes a viernes, de 8:00 a. m. a 5:00 p. m.
PUBLIC_CONTACT_RESPONSE_TIME=un día hábil

# Titular del servicio (textos legales).
PUBLIC_LEGAL_NAME=RDL Soluciones S.A. (dato de prueba)
PUBLIC_LEGAL_ID=3-101-000000
PUBLIC_LEGAL_ADDRESS=San José, Costa Rica (dato de prueba)
PUBLIC_PRIVACY_EMAIL=privacidad@rdl.example

# Analítica Umami (sin cookies). Vacío = no se carga ningún script.
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=
