{
  "name": "rdl-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run tokens && astro dev",
    "build": "npm run tokens && npm run check:content && astro build",
    "preview": "astro preview",
    "lint": "astro check && prettier --check .",
    "format": "prettier --write .",
    "check:content": "node scripts/check-content.mjs",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "tokens": "node scripts/sync-tokens.mjs",
    "lighthouse:local": "node scripts/lighthouse-local.mjs",
    "og": "node scripts/make-og.mjs",
    "capturas": "node scripts/capture-portal.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lucide/astro": "^1.48.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "~6.0.2"
  }
}
