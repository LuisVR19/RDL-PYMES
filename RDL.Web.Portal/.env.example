# Copiar a .env.local (ignorado por git).

# mock    = datos simulados, sesión simulada y barra de revisión (etapa de diseño; lo que usan las pruebas).
# gateway = Supabase Auth real + Portal Gateway (/portal/v1). El portal no habla con ninguna otra API.
VITE_DATA_SOURCE=mock

# --- Solo con VITE_DATA_SOURCE=gateway ---
# Portal Gateway en dev. Su CORS_ALLOWED_ORIGINS tiene que incluir el origen del portal (http://localhost:5173).
VITE_GATEWAY_URL=http://localhost:8090
# Supabase de DEV. La publishable key es pública por diseño. NUNCA la service_role key.
VITE_SUPABASE_URL=https://dzlsnsstuqpxvwegeqcy.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_X0tQqmJnXotXyvec0kCOtw_0h5U2iby
