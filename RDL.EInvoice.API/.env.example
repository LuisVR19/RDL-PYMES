# Copiar a .env (ignorado por git). La API y el migrador lo leen solos al arrancar.
# Nunca poner aquí la service_role key ni datos de producción.

# Proyecto Supabase de DEV. Ya está correcto, no hace falta cambiarlo.
SUPABASE_URL=https://dzlsnsstuqpxvwegeqcy.supabase.co

# Host del pooler: Dashboard → botón "Connect" → pestaña "Session pooler" (el mismo que usa Platform).
# Pegue solo el host (ej. aws-0-us-east-1.pooler.supabase.com) o la cadena completa: se extrae el host.
DB_POOLER_HOST=

# Contraseñas que asignó con ALTER ROLE (fiscal_api y fiscal_migrate). Entre comillas simples;
# no pueden contener comillas simples.
DB_PASSWORD=''
MIGRATE_DB_PASSWORD=''

# --- Opcional: todo lo de abajo tiene valores por defecto razonables ---
# HTTP_ADDR=:8082
# CONSUMER_HTTP_ADDR=:8085              # /healthz y /readyz de cmd/consumer (incremento 3)
# WORKER_HTTP_ADDR=:8086                # /healthz y /readyz de cmd/worker (incremento 9)
# CONSUMER_MESSAGE_TIMEOUT=2m           # tiempo máximo de un evento con todos sus reintentos (mínimo 30s)
# LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=          # vacío = sin exportar trazas/métricas
# DATABASE_URL=...                      # solo si no quiere usar DB_POOLER_HOST
# MIGRATE_DATABASE_URL=...

# --- Hacienda ---
# Solo se admite sandbox: el ambiente de producción de Hacienda está prohibido en V1 (la API no arranca con otro valor).
# HACIENDA_ENVIRONMENT=sandbox
# Identificación de RDL como proveedor de sistemas (ProveedorSistemas). Vacía hasta que exista; sin ella no se envía.
# PROVIDER_IDENTIFICATION=
# RETENTION_YEARS=5                     # conservación de XML y respuestas. TODO(legal): confirmar el plazo
# Las credenciales de Hacienda, el .p12 y su PIN NUNCA van aquí: viven en el SecretStore (decisión 6).
# SecretStore de desarrollo: archivos cifrados con AES-256-GCM en SECRETS_DIR (ignorado por git). La llave son 32 bytes
# en base64 propios de cada máquina; genérela con:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Sin llave, la API arranca pero responde 503 al configurar credenciales o certificado.
# SECRETS_MASTER_KEY=
# SECRETS_DIR=.secrets

# --- Suites contra dev (make test-isolation, make test-e2e) ---
# Dos organizaciones activas de dev con un owner activo (las crea Platform; fiscal no puede). Ids ficticios de
# prueba, nunca de clientes reales.
# ISOLATION_ORG_A=
# ISOLATION_ORG_B=
