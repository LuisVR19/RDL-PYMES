# Copiar a .env (ignorado por git). El gateway lo lee solo al arrancar.
# Este servicio NO tiene base de datos ni credenciales de dominio. Nunca poner aquí la service_role key.

# Proyecto Supabase de DEV: de ahí sale el JWKS con el que se verifica el token del usuario.
SUPABASE_URL=https://dzlsnsstuqpxvwegeqcy.supabase.co

# --- APIs destino ---
# Platform y Billing son obligatorias: sin ellas el portal no abre sesión ni factura.
PLATFORM_API_URL=http://localhost:8080
BILLING_API_URL=http://localhost:8081

# E-Invoice (fiscal) y Receivables todavía no existen. Déjelas vacías: sus rutas responden 503
# `upstream-not-configured` y la vista transversal sale marcando esas partes como `unavailable`.
# Complételas cuando P5 y P6 estén desplegadas.
FISCAL_API_URL=
RECEIVABLES_API_URL=

# --- Opcional: todo lo de abajo tiene valores por defecto razonables ---
# HTTP_ADDR=:8090                       # Platform :8080, Billing :8081, fiscal :8082, Receivables :8083
# CORS_ALLOWED_ORIGINS=http://localhost:5173   # el origen del portal; no admite *
# UPSTREAM_TIMEOUT=5s                   # timeout por llamada a una API
# PLATFORM_API_TIMEOUT=                 # override por servicio (BILLING_, FISCAL_, RECEIVABLES_)
# UPSTREAM_BUDGET=10s                   # presupuesto total de una petición; mayor que cualquier timeout
# HTTP_MAX_REQUEST_BODY=1048576         # 1 MiB
# LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=          # vacío = sin exportar trazas/métricas

# De dónde sale el resumen de factura de la vista transversal:
#   public   = GET /v1/invoices/{id} de Billing (temporal, lo de hoy)
#   internal = GET /internal/v1/invoices/{id}/summary (la ruta del contrato; Billing todavía no la implementa)
# BILLING_SUMMARY_SOURCE=public
